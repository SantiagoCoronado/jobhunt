# jobhunt secrets, copy to `.env` (gitignored) and fill in.
# Only sources you enable in config/sources.yaml need their key set.
# Real environment variables override these values.

# Adzuna (Mexico + 12 countries). Free app_id + app_key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# The Muse. OPTIONAL, works anon at a lower rate limit. Key: https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# Careerjet affiliate id (Mexico via es_MX locale): https://www.careerjet.com/partners/
CAREERJET_AFFID=

# Findwork.dev bearer token (create a free account): https://findwork.dev/developers/
FINDWORK_TOKEN=

# Inbox pull for /jh-gmail-sync (python -m src.mail_fetch). One label per mailbox you apply
# from, comma separated. Each label needs MAIL_<LABEL>_USER and MAIL_<LABEL>_PASS, an APP
# password (never your login password): Gmail needs 2-Step Verification on, then
# https://myaccount.google.com/apppasswords. Other providers and the forwarding fallback for
# Outlook: docs/mail-setup.md. Read-only by protocol; a blank PASS is skipped, never an error.
MAIL_ACCOUNTS=
# MAIL_PERSONAL_USER=
# MAIL_PERSONAL_PASS=
# MAIL_APPS_USER=
# MAIL_APPS_PASS=
# Optional per label. HOST may carry :port (default imap.gmail.com:993). FOLDERS is a comma
# list; Gmail users should add [Gmail]/Spam. ALIASES are other From addresses that are you.
# REPLY_AS is only for a forwarding target: the address replies must go out from.
# MAIL_APPS_HOST=imap.gmail.com
# MAIL_APPS_FOLDERS=INBOX,[Gmail]/Spam
# MAIL_APPS_ALIASES=
# MAIL_APPS_REPLY_AS=
